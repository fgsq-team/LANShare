<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="300dp"
    android:layout_height="60dp"
    android:background="@drawable/focused_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="10dp"
    android:paddingRight="10dp">

    <LinearLayout
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/dev_select_img"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_phone" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginLeft="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dev_select_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/name"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/dev_select_ip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/size"
            android:textColor="?attr/android:textColorSecondary"
            android:textSize="10sp"
            tools:ignore="SmallSp" />


    </LinearLayout>


    <LinearLayout
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dev_select_battery"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_battery2" />

        <TextView
            android:id="@+id/dev_tv_battery"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="@color/limegreen"
            android:textSize="10sp"
            tools:ignore="SmallSp">

        </TextView>

    </LinearLayout>

</LinearLayout>

