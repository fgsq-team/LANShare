<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:id="@+id/ll_text_send"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:background="@drawable/focused_background"
              android:clickable="true"
              android:focusable="true"
              android:nextFocusRight="@+id/main_scan_code"
              android:orientation="horizontal"
              android:padding="5dp">
    <CheckBox
            android:layout_marginTop="5dp"
            android:layout_gravity="center_vertical"
            android:id="@+id/chat_item_check_box"
            android:layout_marginRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    <RelativeLayout
            android:id="@+id/chat_bubble_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp">

        <ImageView
                android:id="@+id/chat_item_header"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentRight="true"
                android:scaleType="centerInside"
                android:src="@drawable/ic_phone"/>

        <TextView
                android:id="@+id/chat_item_tv_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginRight="10dp"
                android:layout_toLeftOf="@+id/chat_item_header"
                android:text="MIX4"/>



        <LinearLayout
                android:id="@+id/rc_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/chat_item_tv_user"
                android:layout_marginEnd="5dp"
                android:layout_marginRight="5dp"
                android:layout_toStartOf="@id/chat_item_header"
                android:layout_toLeftOf="@id/chat_item_header"
                android:background="@drawable/message_text_send"
                android:orientation="vertical"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                <ImageView
                        android:id="@+id/chat_rc_msg_iv_file_type_image"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="12dp"
                        android:layout_marginRight="12dp"
                        android:src="@drawable/rc_file_icon_file"/>

                <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">


                    <TextView
                            android:id="@+id/chat_content"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true"
                            android:layout_gravity="top"
                            android:gravity="top"
                            android:maxWidth="200dp"
                            android:minWidth="100dp"
                            android:scrollHorizontally="false"
                            android:singleLine="false"
                            android:text=""
                            android:textColor="#343434"
                            android:textSize="16sp"/>


                    <TextView
                            android:id="@+id/chat_msg_tv_file_size"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/chat_content"
                            android:text="149kb"
                            android:textColor="#a8a8a8"
                            android:textSize="12dp"/>

                    <TextView
                            android:id="@+id/chat_msg_tv_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/chat_content"
                            android:layout_alignRight="@+id/chat_rc_msg_prog"
                            android:textColor="#a8a8a8"
                            android:textSize="12sp"
                            android:visibility="gone"/>

                    <ProgressBar
                            android:id="@+id/chat_rc_msg_prog"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="140dp"
                            android:layout_height="15dp"
                            android:layout_below="@+id/chat_msg_tv_file_size"
                            android:layout_marginRight="5dp"
                            android:max="100"/>

                    <TextView
                            android:id="@+id/chat_rc_msg_canceled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/chat_msg_tv_file_size"
                            android:text="@string/canceled"
                            android:textColor="#a8a8a8"
                            android:textSize="12sp"
                            android:visibility="gone"/>

                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>

