<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/chatBackgroundColor"
    android:gravity="center"
    android:orientation="vertical">

    <!-- 消息列表 -->
    <LinearLayout
        android:id="@+id/chat_send_message_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_recy"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            tools:ignore="NestedWeights" />

        <!-- 输入区域 -->
        <LinearLayout
            android:id="@+id/chat_edit_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- 设备选择 -->
            <LinearLayout
                android:id="@+id/chat_dev_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp">

                <TextView
                    android:id="@+id/chat_dev_select_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_background"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:maxLines="1"
                    android:maxWidth="200dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/all_devices"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- 输入框 + 发送按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom|center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/chat_et_content"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/message_shap_chat_bg"
                    android:hint="@string/send_message_hint"
                    android:maxLines="6"
                    android:minHeight="40dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textColor="?attr/android:textColorPrimary"
                    android:textColorHint="?attr/android:textColorTertiary"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/chat_btn_send"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_send_circle_background"
                    android:contentDescription="@string/send"
                    android:padding="8dp"
                    android:saveEnabled="false"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_send_white" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
