<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent"
              android:fitsSystemWindows="true"

              android:orientation="vertical">

    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="90dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/colorPrimary"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="10dp">

            <ImageView
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:id="@+id/about_exit_img"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    app:tint="@color/cool_dark"
                    android:src="@drawable/ic_exit"/>
            <TextView
                    android:layout_marginLeft="20px"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/cool_dark"
                    android:textSize="20sp"
                    android:text="@string/about">
            </TextView>
        </LinearLayout>

    </RelativeLayout>

    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="120dp">

        <ImageView
                android:id="@+id/about_logo"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/focused_background"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:src="@mipmap/ic_launcher"/>

        <TextView
                android:id="@+id/aboutTextView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>

        <TextView
                android:id="@+id/about_version_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@id/aboutTextView1"
                android:layout_centerHorizontal="true"
                android:text="@string/version"
                android:textColor="#000000"
                android:textSize="16sp"/>

    </RelativeLayout>
    <LinearLayout
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <TextView
                android:layout_marginTop="5dp"
                android:id="@+id/about_build_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
        />
    </LinearLayout>

    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <LinearLayout
                android:id="@+id/aboutLinearLayout1"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_alignParentBottom="true"
                android:orientation="vertical"/>

        <TextView
                android:id="@+id/about_copyright"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@id/aboutLinearLayout1"
                android:layout_centerHorizontal="true"
                android:text="@string/copyright"/>


        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_above="@id/about_copyright"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="30dp">

            <!--    <RelativeLayout
                    android:id="@+id/about_github"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/focused_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_alignParentTop="true"
                        android:background="#5F5F5F" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="@string/github" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_next" />

                </RelativeLayout>-->
            <RelativeLayout
                    android:id="@+id/about_official_website"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/focused_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal">


                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:text="@string/official_website"/>

                <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_next"/>
            </RelativeLayout>
            <RelativeLayout
                    android:id="@+id/about_update_version"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/focused_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal">


                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:text="@string/check_update"/>

                <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_next"/>
            </RelativeLayout>

            <RelativeLayout
                    android:id="@+id/about_upload_logs"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:visibility="gone"
                    android:background="@drawable/focused_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:text="@string/upload_logs"/>

                <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_next"/>
            </RelativeLayout>


            <RelativeLayout
                    android:id="@+id/about_help"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/focused_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal">


                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:text="@string/help"/>

                <!-- <View
                         android:layout_width="match_parent"
                         android:layout_height="0.5dp"
                         android:layout_alignParentTop="true"
                         android:background="#5F5F5F"/>-->

                <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_next"/>

            </RelativeLayout>

            <RelativeLayout
                    android:id="@+id/about_privacy"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/focused_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:text="@string/privacy"/>
                <!--

                                <View
                                        android:layout_width="match_parent"
                                        android:layout_height="0.5dp"
                                        android:layout_alignParentTop="true"
                                        android:background="#5F5F5F"/>
                -->

                <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_next"/>

            </RelativeLayout>

            <RelativeLayout
                    android:id="@+id/about_group"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/focused_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal">
                <!--
                                <View
                                        android:layout_width="match_parent"
                                        android:layout_height="0.5dp"
                                        android:layout_alignParentBottom="true"
                                        android:background="#5F5F5F"/>-->

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:text="@string/join_group"/>

                <!--    <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_alignParentTop="true"
                            android:background="#5F5F5F"/>-->

                <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_next"/>

            </RelativeLayout>


        </LinearLayout>

    </RelativeLayout>

</LinearLayout>

