<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme - Material Design 3 -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSecondary">@color/colorSecondary</item>

        <!-- Background and text colors -->
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="android:colorBackground">@color/backgroundColor</item>
        <item name="android:textColorPrimary">@color/textColorPrimary</item>
        <item name="android:textColorSecondary">@color/textColorSecondary</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/statusBarColor</item>
        <item name="android:navigationBarColor">@color/bottomBackgroundColor</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- CardView styles -->
        <item name="cardViewStyle">@style/Widget.App.CardView</item>
        
        <!-- Button styles -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        
        <!-- Toolbar popup -->
        <item name="popupMenuStyle">@style/Widget.App.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.App.PopupMenu.Overflow</item>
        
        <!-- Dialog -->
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>
        <item name="dialogTheme">@style/AlertDialogTheme</item>
        
        <!-- Switch -->
        <item name="switchStyle">@style/Widget.App.Switch</item>

        <!-- Custom theme attributes for multi-theme support -->
        <item name="dividerColor">@color/dividerColor</item>
        <item name="cardStrokeColor">@color/cardStrokeColor</item>
        <item name="toolbarBackground">@color/toolbarBackground</item>
        <item name="toolbarTextColor">@color/toolbarTextColor</item>
        <item name="buttonBackgroundColor">@color/buttonBackgroundColor</item>
        <item name="buttonTextColor">@color/buttonTextColor</item>
        <item name="buttonRippleColor">@color/buttonRippleColor</item>
        <item name="chatRightBackgroundColor">@color/chatRightBackgroundColor</item>
        <item name="chatLeftBackgroundColor">@color/chatLeftBackgroundColor</item>
        <item name="chatRightTextColor">@color/chatRightTextColor</item>
        <item name="chatLeftTextColor">@color/chatLeftTextColor</item>
        <item name="chatBackgroundColor">@color/chatBackgroundColor</item>
        <item name="bottomTextColor">@color/bottomTextColor</item>
        <item name="bottomSelectedTextColor">@color/bottomSelectedTextColor</item>
        <item name="bottomBackgroundColor">@color/bottomBackgroundColor</item>
        <item name="bottomIndicatorColor">@color/bottomIndicatorColor</item>
        <item name="iconColor">@color/iconColor</item>
        <item name="iconSelectedColor">@color/iconSelectedColor</item>
        <item name="mediaTextColor">@color/mediaTextColor</item>
        <item name="chatInfoTextColor">@color/chatInfoTextColor</item>
        <item name="chatLeftInfoTextColor">@color/chatLeftInfoTextColor</item>
        <item name="chatRightInfoTextColor">@color/chatRightInfoTextColor</item>
        <item name="errorTextColor">@color/errorTextColor</item>
        <item name="successTextColor">@color/successTextColor</item>
        <item name="chatLeftSuccessColor">@color/chatLeftSuccessColor</item>
        <item name="chatRightSuccessColor">@color/chatRightSuccessColor</item>
        <item name="textSelectColor">@color/text_select</item>
        <item name="textNotSelectColor">@color/textNotSelectColor</item>
        <item name="itemTextColor">@color/itemTextColor</item>
        <item name="rippleColor">@color/rippleColor</item>
        <item name="shadowColor">@color/shadowColor</item>
        <item name="gainsboro">@color/gainsboro</item>
        <item name="colorPrimaryLight">@color/colorPrimaryLight</item>
        <item name="colorSurfaceVariant">@color/surfaceVariantColor</item>
        <item name="fileIconBgColor">@color/fileIconBgColor</item>
        <item name="deviceInfoTextColor">@color/deviceInfoTextColor</item>
    </style>

    <!-- CardView Style -->
    <style name="Widget.App.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/cardBackgroundColor</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/cardStrokeColor</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Button Style -->
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/buttonBackgroundColor</item>
        <item name="android:textColor">@color/buttonTextColor</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="rippleColor">@color/buttonRippleColor</item>
    </style>

    <!-- Popup Menu Style -->
    <style name="Widget.App.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_menu_background</item>
    </style>

    <style name="Widget.App.PopupMenu.Overflow" parent="Widget.MaterialComponents.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/popup_menu_background</item>
        <item name="overlapAnchor">true</item>
    </style>

    <!-- Dialog Styles -->
    <style name="AlertDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="dialogCornerRadius">16dp</item>
        <item name="android:textColorPrimary">@color/textColorPrimary</item>
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="android:background">@color/surfaceColor</item>
        <item name="android:textColorAlertDialogListItem">@color/textColorPrimary</item>
    </style>

    <style name="Theme.App.AlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:textColorPrimary">@color/textColorPrimary</item>
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="android:background">@color/surfaceColor</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.LargeComponent</item>
    </style>

    <style name="Theme.App.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:background">@color/surfaceColor</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.LargeComponent</item>
    </style>

    <!-- Switch Style -->
    <style name="Widget.App.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb_selector</item>
        <item name="trackTint">@color/switch_track_selector</item>
    </style>

    <!-- Shape Appearance -->
    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Material3.Corner.Full" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.Material3.Corner.Large" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Material3.Corner.Medium" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Toolbar Title Text -->
    <style name="TextAppearance.App.Toolbar.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/toolbarTextColor</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Bottom Navigation Text -->
    <style name="TextAppearance.App.BottomNavigation" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Tab Text -->
    <style name="TextAppearance.App.Tab" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ============================================ -->
    <!-- Emerald (翠绿) Theme - 清新自然的绿色调方案  -->
    <!-- ============================================ -->
    <style name="AppTheme.Emerald" parent="AppTheme">
        <item name="colorPrimary">#2E7D32</item>
        <item name="colorPrimaryDark">#1B5E20</item>
        <item name="colorAccent">#FF8F00</item>
        <item name="colorSecondary">#00897B</item>

        <item name="android:windowBackground">#F6FBF6</item>
        <item name="android:colorBackground">#F6FBF6</item>
        <item name="android:textColorPrimary">#1A1C1E</item>
        <item name="android:textColorSecondary">#5F6368</item>

        <item name="android:statusBarColor">#F6FBF6</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="cardViewStyle">@style/Widget.App.Emerald.CardView</item>
        <item name="materialButtonStyle">@style/Widget.App.Emerald.Button</item>
        <item name="alertDialogTheme">@style/AlertDialogTheme.Emerald</item>
        <item name="dialogTheme">@style/AlertDialogTheme.Emerald</item>
        <item name="switchStyle">@style/Widget.App.Switch</item>

        <!-- Custom theme attributes - Emerald values -->
        <item name="dividerColor">#C8E6C9</item>
        <item name="cardStrokeColor">#C8E6C9</item>
        <item name="toolbarBackground">#FFFFFF</item>
        <item name="toolbarTextColor">#1A1C1E</item>
        <item name="buttonBackgroundColor">#2E7D32</item>
        <item name="buttonTextColor">#FFFFFF</item>
        <item name="buttonRippleColor">#1B5E20</item>
        <item name="chatRightBackgroundColor">#2E7D32</item>
        <item name="chatLeftBackgroundColor">#D8ECD8</item>
        <item name="chatRightTextColor">#FFFFFF</item>
        <item name="chatLeftTextColor">#1A1C1E</item>
        <item name="chatBackgroundColor">#F6FBF6</item>
        <item name="bottomTextColor">#9E9E9E</item>
        <item name="bottomSelectedTextColor">#2E7D32</item>
        <item name="bottomBackgroundColor">#FFFFFF</item>
        <item name="bottomIndicatorColor">#E8F5E9</item>
        <item name="iconColor">#5F6368</item>
        <item name="iconSelectedColor">#2E7D32</item>
        <item name="mediaTextColor">#5F6368</item>
        <item name="chatInfoTextColor">#757575</item>
        <item name="chatLeftInfoTextColor">#757575</item>
        <item name="chatRightInfoTextColor">#C0C0C0</item>
        <item name="errorTextColor">#D32F2F</item>
        <item name="successTextColor">#388E3C</item>
        <item name="chatLeftSuccessColor">#388E3C</item>
        <item name="chatRightSuccessColor">#A5D6A7</item>
        <item name="textSelectColor">#2E7D32</item>
        <item name="textNotSelectColor">#9E9E9E</item>
        <item name="itemTextColor">#5F6368</item>
        <item name="rippleColor">#1A000000</item>
        <item name="shadowColor">#14000000</item>
        <item name="gainsboro">#C8E6C9</item>
        <item name="colorPrimaryLight">#E8F5E9</item>
        <item name="colorSurfaceVariant">#EDF7ED</item>
        <item name="fileIconBgColor">#FFFFFF</item>
        <item name="deviceInfoTextColor">#9E9E9E</item>
    </style>

    <!-- Emerald CardView -->
    <style name="Widget.App.Emerald.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">#FFFFFF</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">#C8E6C9</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Emerald Button -->
    <style name="Widget.App.Emerald.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">#2E7D32</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="rippleColor">#1B5E20</item>
    </style>

    <!-- Emerald Dialog -->
    <style name="AlertDialogTheme.Emerald" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorPrimary">#2E7D32</item>
        <item name="colorAccent">#FF8F00</item>
        <item name="dialogCornerRadius">16dp</item>
        <item name="android:textColorPrimary">#1A1C1E</item>
        <item name="android:textColor">#1A1C1E</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:textColorAlertDialogListItem">#1A1C1E</item>
    </style>

</resources>